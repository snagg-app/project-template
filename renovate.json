{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabled": true,
  "dependencyDashboard": false,
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 3,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "rebaseWhen": "behind-base-branch",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/workflow-kit\\.yml$/"],
      "matchStrings": ["WORKFLOW_KIT_REF: (?<currentDigest>[a-f0-9]{40})"],
      "currentValueTemplate": "main",
      "depNameTemplate": "snagg-app/workflow-kit",
      "packageNameTemplate": "https://github.com/snagg-app/workflow-kit.git",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["git-refs"],
      "minimumReleaseAge": null
    }
  ]
}
